[Unit]
Description=Airlys OS S1 First Boot Initialization
Before=sddm.service display-manager.service
RequiredBy=sddm.service display-manager.service
ConditionFirstBoot=no

[Service]
Type=oneshot
ExecStart=/usr/local/bin/airlys-firstrun.sh
RemainAfterExit=yes

[Install]
WantedBy=graphical.target multi-user.target
